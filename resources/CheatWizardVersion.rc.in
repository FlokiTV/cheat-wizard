#include <windows.h>

101 ICON "@CW_ICON_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Cheat Wizard Open Source Project\0"
            VALUE "FileDescription", "@CW_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "@CW_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Cheat Wizard contributors\0"
            VALUE "OriginalFilename", "@CW_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Cheat Wizard\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
