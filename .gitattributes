* text=auto
.gitattributes text eol=lf

# Keep repository text deterministic across Windows/Linux tooling.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Generated/persistent binary formats.
*.exe binary
*.zip binary
*.cwptr binary
*.cwchain binary
*.cwmap binary
*.cwscan binary
*.cwaob binary
*.cwtrainer text eol=lf
*.mcptr binary
*.mcep binary
*.mcpm binary
*.mces binary
*.mcea binary
